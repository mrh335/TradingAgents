# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=

# ── Financial Planner integration ────────────────────────────────────────────
# Pulls account + holdings data from a separate financial-planner instance
# (the companion project) and upserts it into TradingAgents' positions
# table. Used by /planner/status and /planner/sync.
#
# PLANNER_API_URL  — base URL of the planner, no trailing slash
#                    e.g. http://192.168.2.34:8765
# PLANNER_API_KEY  — must match INTEGRATION_API_KEY on the planner side
#
# Leave both empty to disable the integration; /planner/status will
# return configured=false and the UI hides the sync button.
PLANNER_API_URL=
PLANNER_API_KEY=

# ── Cloudflare Tunnel (Cowork bridge) ────────────────────────────────────────
# Exposes the API to public HTTPS without port-forwarding or VPN — lets
# Anthropic Cowork (or any cloud-hosted Claude) reach /sidecars/pending.
#
# Two modes:
#   1. Named tunnel (recommended, stable URL):
#        - sign in to Cloudflare → Zero Trust → Networks → Tunnels
#        - create a tunnel, copy the "docker run" token
#        - paste the token here as CLOUDFLARED_TOKEN
#        - in the dashboard, map a hostname → http://api:8000
#        - run: docker compose --profile tunnel up -d cloudflared
#
#   2. Quick tunnel (zero setup, ephemeral *.trycloudflare.com URL):
#        - leave CLOUDFLARED_TOKEN empty
#        - run: docker compose --profile tunnel up -d cloudflared
#        - grab the URL from: docker compose logs cloudflared
#
# See docs/COWORK.md for the full walk-through.
CLOUDFLARED_TOKEN=
CLOUDFLARED_CMD=
