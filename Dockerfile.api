# FastAPI service image. Reuses the same Python deps as the GUI (we
# install with [service] extras which include FastAPI + uvicorn +
# websockets in addition to the framework's core deps).
#
# Build:    docker compose build api
# Run:      docker compose up -d api
# Logs:     docker compose logs -f api

FROM python:3.12-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# pycairo (transitive: xhtml2pdf -> svglib -> rlpycairo) needs gcc + libcairo2-dev.
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        libcairo2-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /build

# ── Dependency layer ────────────────────────────────────────────────
# Install third-party deps FIRST, against empty package stubs, so this
# slow layer is cached and only re-runs when pyproject.toml changes.
# Previously ALL source was COPYd before `pip install`, so editing any
# backend file busted the cache and reinstalled the entire dependency
# tree (langchain ×4, langgraph, pandas, hmmlearn→sklearn/scipy,
# matplotlib, backtrader) AND recompiled pycairo via gcc — a 2-3 min
# rebuild on every change. The stub packages satisfy setuptools'
# package discovery; we uninstall the empty wheel right after so the
# real source install below isn't skipped as "already satisfied".
COPY pyproject.toml README.md ./
RUN mkdir -p tradingagents cli gui service \
    && touch tradingagents/__init__.py cli/__init__.py gui/__init__.py service/__init__.py \
    && pip install --no-cache-dir '.[gui,service]' \
    && pip uninstall -y tradingagents \
    && rm -rf *.egg-info tradingagents cli gui service

# ── Source layer ────────────────────────────────────────────────────
# Now copy the real source. A code change busts only from here down, and
# `pip install --no-deps .` merely reinstalls the package (no compilation,
# no re-download) — seconds instead of minutes.
COPY tradingagents ./tradingagents
COPY cli ./cli
COPY gui ./gui
COPY service ./service
# scripts/ — maintenance utilities the user can run via
# ``docker exec ... python -m scripts.<name>`` from outside.
COPY scripts ./scripts
RUN pip install --no-cache-dir --no-deps .

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# pycairo needs libcairo2 at runtime.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libcairo2 \
    && rm -rf /var/lib/apt/lists/*

# Create the user + workdir BEFORE copying the venv and source so these
# layers stay cached across source-only rebuilds (they don't depend on app
# content). Previously they sat after the venv COPY, so every backend edit
# re-ran groupadd/useradd + WORKDIR — ~100s each on the NAS's slow disk.
RUN groupadd --gid 1000 appuser && useradd --uid 1000 --gid 1000 --create-home appuser
WORKDIR /home/appuser/app
ENV PATH="/opt/venv/bin:$PATH"

# Heavy COPYs last: the venv COPY busts only when deps change; the source
# COPY busts on every code edit. Keeping them after the cheap layers above
# means a backend edit only re-runs these two (plus the image export).
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder --chown=appuser:appuser /build .
USER appuser

EXPOSE 8000
CMD ["uvicorn", "service.app:app", "--host", "0.0.0.0", "--port", "8000"]
