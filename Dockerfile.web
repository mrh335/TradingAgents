# Next.js production image — multi-stage with `output: standalone`
# to keep the final image small (~250MB instead of ~1GB).

FROM node:20-alpine AS deps
WORKDIR /build
COPY web/package.json web/package-lock.json ./
# `npm ci` is faster and fully reproducible — it installs straight from
# the lockfile and errors if package.json and the lock drift out of sync
# (vs `npm install`, which silently mutates the tree). NODE_ENV is unset
# in this stage so devDeps (incl. the `next` CLI used by `npm run build`)
# are installed.
RUN npm ci --no-audit --no-fund --legacy-peer-deps

FROM node:20-alpine AS builder
WORKDIR /build
COPY --from=deps /build/node_modules ./node_modules
COPY web ./

# Next.js inlines NEXT_PUBLIC_* env vars at BUILD time (not runtime). Setting
# them only in `environment:` on docker-compose has no effect — the bundle
# was already compiled. Take the URL as a build arg so the value baked into
# the JS matches the public LAN address.
ARG NEXT_PUBLIC_WS_BASE=ws://api:8000
ENV NEXT_PUBLIC_WS_BASE=$NEXT_PUBLIC_WS_BASE

RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nextjs && adduser --system --uid 1001 nextjs

# Standalone output bundles everything the runtime needs:
COPY --from=builder --chown=nextjs:nextjs /build/.next/standalone ./
COPY --from=builder --chown=nextjs:nextjs /build/.next/static ./.next/static
# We don't ship any static assets in /public yet, so no COPY for that.
# Add it back as ``COPY --from=builder /build/public ./public`` if/when
# /public has files (favicon, og-image, etc.).

USER nextjs
EXPOSE 3000
ENV PORT=3000 HOSTNAME=0.0.0.0
CMD ["node", "server.js"]
